{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridsheet.local/schemas/presets.schema.v2.json",
  "title": "GridSheet Character Sheet & Preset Schema v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["systemName", "systemCode", "characterName", "cards"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "systemId": {
      "type": "string",
      "enum": ["wod", "dnd5e", "cyberpunk", "default", "blank"]
    },
    "systemName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "systemCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "characterName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tabs": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/TabDefinition" }
    },
    "cards": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/BentoCard" }
    },
    "rollLogs": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/RollLogEntry" }
    },
    "xp": { "$ref": "#/$defs/XpState" },
    "rulePreset": {
      "type": "string",
      "enum": ["storyteller_v20", "storyteller-v20", "vampire_v5", "vampire-v5", "custom"]
    },
    "xpRulePreset": {
      "type": "string",
      "enum": ["storyteller_v20", "storyteller-v20", "vampire_v5", "vampire-v5", "custom"]
    },
    "customUseNewLevelBase": {
      "type": "boolean"
    },
    "bloodPool": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "bloodSurge": {
      "type": "boolean"
    },
    "virtues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conscience": { "type": "integer", "minimum": 1, "maximum": 5 },
        "selfControl": { "type": "integer", "minimum": 1, "maximum": 5 },
        "courage": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  },
  "$defs": {
    "TabDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "enum": ["geral", "magias", "xp"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "BentoCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tab", "code", "title", "colSpan", "fields"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tab": { "type": "string", "enum": ["geral", "magias", "xp"] },
        "code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "colSpan": { "type": "integer", "minimum": 1, "maximum": 4 },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/SheetField" }
        }
      }
    },
    "RepeatableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "col1", "col2"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "col1": { "type": "string", "maxLength": 200 },
        "col2": { "type": ["number", "string"] }
      }
    },
    "SheetField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "label", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": {
          "type": "string",
          "enum": ["number", "text", "calculated", "resource", "boolean", "roll", "repeatable"]
        },
        "value": { "type": ["number", "string", "boolean", "null"] },
        "numValue": { "type": ["number", "null"] },
        "textValue": { "type": ["string", "null"] },
        "boolValue": { "type": ["boolean", "null"] },
        "max": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxFormula": { "type": "string", "maxLength": 256 },
        "attributeGroup": { "type": "string", "enum": ["physical", "social", "mental"] },
        "damageTrack": { "type": "boolean" },
        "superficialDamage": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "aggravatedDamage": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "bashingDamage": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "lethalDamage": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "soakDamageType": { "type": "string", "enum": ["bashing", "lethal", "aggravated"] },
        "formula": { "type": "string", "maxLength": 256 },
        "showPlus": { "type": "boolean" },
        "rollLabel": { "type": "string", "maxLength": 80 },
        "rollExpr": { "type": "string", "maxLength": 256 },
        "rollDifficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rollDifficultyV5": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rollMod": { "type": "integer", "minimum": -100, "maximum": 100 },
        "rollSpecialty": { "type": "boolean" },
        "useWillpower": { "type": "boolean" },
        "isSoak": { "type": "boolean" },
        "xpCategory": {
          "type": "string",
          "enum": [
            "attribute",
            "skill",
            "discipline",
            "virtue",
            "advantage",
            "discipline_clan",
            "discipline_out_of_clan",
            "discipline_caitiff"
          ]
        },
        "columns": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 64 }
        },
        "col2Type": { "type": "string", "enum": ["number", "text"] },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/RepeatableRow" }
        },
        "hint": { "type": "string", "maxLength": 240 },
        "placeholder": { "type": "string", "maxLength": 240 }
      }
    },
    "RollLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "label", "total", "formula", "breakdown"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "timestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "total": { "type": "number" },
        "formula": { "type": "string", "maxLength": 256 },
        "breakdown": { "type": "string", "maxLength": 512 },
        "isCritical": { "type": "boolean" },
        "isFumble": { "type": "boolean" },
        "isPoolRoll": { "type": "boolean" },
        "rolls": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
        "specialty": { "type": "boolean" },
        "willpowerUsed": { "type": "boolean" },
        "isSoak": { "type": "boolean" },
        "soakDamageType": { "type": "string", "enum": ["bashing", "lethal", "aggravated"] },
        "doubledTensCount": { "type": "integer", "minimum": 0 },
        "onesCount": { "type": "integer", "minimum": 0 },
        "canceledOnes": { "type": "integer", "minimum": 0 },
        "outcome": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["success", "critical", "messy_critical", "failure", "bestial_failure"]
        },
        "margin": { "type": "integer" },
        "rulePreset": {
          "type": "string",
          "enum": ["storyteller_v20", "storyteller-v20", "vampire_v5", "vampire-v5", "custom"]
        },
        "woundPenalty": { "type": "integer" },
        "hungerDice": { "type": ["integer", "array"] },
        "normalDice": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "normalRolls": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "hungerRolls": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "messyCritical": { "type": "boolean" },
        "isMessyCritical": { "type": "boolean" },
        "bestialFailure": { "type": "boolean" },
        "isBestialFailure": { "type": "boolean" },
        "critPairsCount": { "type": "integer", "minimum": 0 },
        "isRouseCheck": { "type": "boolean" },
        "isBloodSurge": { "type": "boolean" },
        "isWillpowerReroll": { "type": "boolean" },
        "rerolledIndices": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "XpLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "kind", "delta", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "timestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kind": { "type": "string", "enum": ["award", "upgrade"] },
        "delta": { "type": "integer" },
        "xpSpent": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fieldId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["attribute", "skill", "discipline", "virtue"] },
        "fromValue": { "type": "integer" },
        "toValue": { "type": "integer" },
        "createdField": { "type": "boolean" },
        "createdFieldIds": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 64 }
        },
        "createdCardId": { "type": "string", "maxLength": 64 },
        "prevSpecialtyLabel": { "type": "string", "maxLength": 120 },
        "prevRollSpecialty": { "type": "boolean" }
      }
    },
    "XpState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalEarned", "spent", "ledger"],
      "properties": {
        "totalEarned": { "type": "integer", "minimum": 0 },
        "spent": { "type": "integer", "minimum": 0 },
        "ledger": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/XpLedgerEntry" }
        },
        "outOfClanFieldIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 }
        },
        "customMultipliers": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "xpRulePreset": {
          "type": "string",
          "enum": ["storyteller_v20", "storyteller-v20", "vampire_v5", "vampire-v5", "custom"]
        },
        "customUseNewLevelBase": {
          "type": "boolean"
        }
      }
    }
  }
}
