# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SYNC_TOKEN: Bearer token required for /api/sync endpoints.
# If left empty in development, a random 16-byte hex token is generated on startup.
SYNC_TOKEN=

# ALLOW_LAN_SYNC: When true, binds the server to 0.0.0.0 instead of 127.0.0.1.
ALLOW_LAN_SYNC=false

